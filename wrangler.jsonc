{
  // Cloudflare Workers settings. See docs/deploy.md for the one-time setup.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moneymoneymoney",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Run next to the database (Supabase, AWS London), so the handful of
  // queries behind each page are 1-3 ms each instead of ~170 ms from South
  // Africa. Change this if the Supabase project is in another region.
  "placement": {
    "region": "aws:eu-west-2"
  },
  // The database, through Hyperdrive (created with query caching disabled,
  // so a page never shows totals from before your last change).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
      // Only for `npm run preview` on your own computer.
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5433/moneymoneymoney"
    }
  ],
  "vars": {
    // At most two people per household. Sign-up is closed once your household exists.
    "MAX_HOUSEHOLD_MEMBERS": "2"
  }
  // SESSION_SECRET is a secret, set in the dashboard or with `npx wrangler secret put SESSION_SECRET`.
}
